{
  "version": 2,
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/analyze-ticket",
      "destination": "/api/analyze-ticket"
    },
    {
      "source": "/",
      "destination": "/api/health"
    }
  ]
}
